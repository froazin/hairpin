<Project Sdk="MSTest.Sdk">

  <!-- High-value tests of the executable's start-up and logging. MSTest.Sdk's version is pinned in global.json. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>WSLProxy.App.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- No telemetry, code coverage or TRX extensions: keep the test dependencies minimal. -->
    <TestingExtensionsProfile>None</TestingExtensionsProfile>
    <!-- Run tests through the signed dotnet host, not an unsigned apphost exe that Application Control (Smart App Control, WDAC) can block. -->
    <UseAppHost>false</UseAppHost>
    <!-- Test names describe behaviour, so underscores are fine, and tests log through the plain extension methods. -->
    <NoWarn>$(NoWarn);CA1707;CA1848</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WSLProxy.App\WSLProxy.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- appsettings.json arrives with the App project's output. The schema doesn't ship, so the tests copy it themselves. -->
    <None Include="..\WSLProxy.App\appsettings.schema.json" Link="appsettings.schema.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
