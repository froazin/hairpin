<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Restore only from nuget.org, and only packages that nuget.org has countersigned for a trusted owner. -->
  <packageSources>
    <clear />
    <!-- minPublishAgeHours: newly published versions are not picked by dotnet package add/update for 7 days (NuGet 8.0+, .NET SDK 11+). Restore of pinned versions is not affected. -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" minPublishAgeHours="168" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <config>
    <add key="signatureValidationMode" value="require" />
  </config>

  <!--
    The nuget.org repository certificate, read from a restored package with
    dotnet nuget verify (all signatures, detailed verbosity). It's valid until 2027-05-19.
    When nuget.org rotates it, add the new fingerprint alongside this one.
    Owners: Microsoft (runtime, extensions and MSTest packages) and gittools (the GitVersion build tool).
  -->
  <trustedSigners>
    <repository name="nuget.org" serviceIndex="https://api.nuget.org/v3/index.json">
      <certificate fingerprint="1F4B311D9ACC115C8DC8018B5A49E00FCE6DA8E2855F9F014CA6F34570BC482D" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
      <owners>Microsoft;gittools</owners>
    </repository>
  </trustedSigners>
</configuration>
