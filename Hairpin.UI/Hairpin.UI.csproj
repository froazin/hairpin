<Project Sdk="Microsoft.NET.Sdk">

  <!-- The tray icon, flyout and settings window. A WPF class library hosted by Hairpin.App. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Hairpin.UI</RootNamespace>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hairpin.Engine\Hairpin.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hairpin.UI.Tests" />
  </ItemGroup>

  <!-- Tray glyphs: one for a light taskbar, one for a dark taskbar. -->
  <ItemGroup>
    <EmbeddedResource Include="..\Assets\hairpin-light-theme.ico" LogicalName="Hairpin.UI.Tray.LightTheme.ico" Link="Assets\hairpin-light-theme.ico" />
    <EmbeddedResource Include="..\Assets\hairpin-dark-theme.ico" LogicalName="Hairpin.UI.Tray.DarkTheme.ico" Link="Assets\hairpin-dark-theme.ico" />
  </ItemGroup>

</Project>
