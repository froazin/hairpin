<Project Sdk="Microsoft.NET.Sdk">

  <!-- The tray icon, flyout and settings window. A WPF class library hosted by WSLProxy.App. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>WSLProxy.UI</RootNamespace>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WSLProxy.Relay\WSLProxy.Relay.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WSLProxy.UI.Tests" />
  </ItemGroup>

  <!-- Tray glyphs: one for a light taskbar, one for a dark taskbar. -->
  <ItemGroup>
    <EmbeddedResource Include="..\Assets\wslproxy-light-theme.ico" LogicalName="WSLProxy.UI.Tray.LightTheme.ico" Link="Assets\wslproxy-light-theme.ico" />
    <EmbeddedResource Include="..\Assets\wslproxy-dark-theme.ico" LogicalName="WSLProxy.UI.Tray.DarkTheme.ico" Link="Assets\wslproxy-dark-theme.ico" />
  </ItemGroup>

</Project>
