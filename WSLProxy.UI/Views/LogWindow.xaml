<Window x:Class="WSLProxy.UI.Views.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WSL Proxy Relay logs"
        Width="900"
        Height="540"
        MinWidth="520"
        MinHeight="320"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        UseLayoutRounding="True">
    <DockPanel Margin="16">
        <!-- Filters and actions. -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12" LastChildFill="False">
            <ComboBox x:Name="LevelBox" Width="190" SelectedIndex="1" SelectionChanged="OnFilterChanged"
                      AutomationProperties.Name="Lowest level to show">
                <ComboBoxItem Content="Everything" />
                <ComboBoxItem Content="Information and above" />
                <ComboBoxItem Content="Warnings and errors" />
                <ComboBoxItem Content="Errors only" />
            </ComboBox>
            <TextBlock Text="Filter" Margin="12,0,6,0" VerticalAlignment="Center" />
            <TextBox x:Name="FilterBox" Width="200" TextChanged="OnFilterChanged"
                     AutomationProperties.Name="Show only lines containing this text" ToolTip="Show only lines containing this text" />
            <CheckBox x:Name="FollowBox" Content="Follow new lines" IsChecked="True" Margin="12,0,0,0" VerticalAlignment="Center"
                      Checked="OnFollowChanged" />
            <Button DockPanel.Dock="Right" Content="Open log folder" Margin="8,0,0,0" Click="OnOpenFolderClick" />
            <Button DockPanel.Dock="Right" Content="Clear" Margin="8,0,0,0" Click="OnClearClick"
                    ToolTip="Clear the lines kept in memory. The log files aren't changed." />
            <Button DockPanel.Dock="Right" x:Name="CopyButton" Content="Copy" Click="OnCopyClick"
                    ToolTip="Copy the lines shown to the clipboard" />
        </DockPanel>

        <TextBlock x:Name="SummaryText" DockPanel.Dock="Bottom" Margin="0,8,0,0"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Style="{DynamicResource CaptionTextBlockStyle}" />

        <ListView x:Name="EntriesList" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Recent log lines">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Static GridView.GridViewItemContainerStyleKey}}">
                    <Setter Property="Padding" Value="4,1" />
                    <Setter Property="MinHeight" Value="0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Tone}" Value="Quiet">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Tone}" Value="Warning">
                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Tone}" Value="Error">
                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Time" Width="100" DisplayMemberBinding="{Binding Time}" />
                    <GridViewColumn Header="Level" Width="64" DisplayMemberBinding="{Binding Level}" />
                    <GridViewColumn Header="Source" Width="140" DisplayMemberBinding="{Binding Source}" />
                    <GridViewColumn Header="Message" Width="560" DisplayMemberBinding="{Binding Message}" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
