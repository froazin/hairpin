<Window x:Class="WSLProxy.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WSL Proxy Relay settings"
        Width="560"
        Height="680"
        MinWidth="460"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,2,0,10" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Footer: problems and the buttons. -->
        <Border DockPanel.Dock="Bottom" Padding="24,12" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                Background="{DynamicResource LayerFillColorDefaultBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="SaveButton" Content="Save" MinWidth="96" Margin="0,0,8,0" IsDefault="True"
                            Style="{DynamicResource AccentButtonStyle}" Click="OnSaveClick" />
                    <Button Content="Cancel" MinWidth="96" Click="OnCancelClick" />
                </StackPanel>
                <TextBlock x:Name="ProblemText" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,24,12">
                <TextBlock Text="Settings" Style="{DynamicResource SubtitleTextBlockStyle}" Margin="0,0,0,16" />

                <!-- Upstream proxy. -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Upstream proxy" Style="{DynamicResource BodyStrongTextBlockStyle}" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Leave this empty to start with. Without an upstream proxy the relay connects to each destination itself, from Windows, so your endpoint agent already handles the traffic. Add one only if direct connections don't work." />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="96" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <Label Content="Host" Target="{Binding ElementName=UpstreamHostBox}" Padding="0,0,0,4" />
                                <TextBox x:Name="UpstreamHostBox" AutomationProperties.Name="Upstream proxy host" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Label Content="Port" Target="{Binding ElementName=UpstreamPortBox}" Padding="0,0,0,4" />
                                <TextBox x:Name="UpstreamPortBox" AutomationProperties.Name="Upstream proxy port" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Bypass list. -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Bypass list (no_proxy)" Style="{DynamicResource BodyStrongTextBlockStyle}" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Destinations that go direct instead of through the upstream proxy. Only used when an upstream proxy is set. Examples: corp.example (and its subdomains), *.corp.example (subdomains only), 10.0.0.0/8, intranet.example:8443." />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="NewEntryBox" KeyDown="OnNewEntryKeyDown" AutomationProperties.Name="New bypass entry" />
                            <Button Grid.Column="1" Content="Add" MinWidth="72" Margin="8,0,0,0" Click="OnAddClick" />
                        </Grid>
                        <TextBlock x:Name="EntryProblemText" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed" />
                        <ListBox x:Name="EntriesList" Height="160" SelectionMode="Extended"
                                 FontFamily="Cascadia Mono, Consolas" AutomationProperties.Name="Bypass entries" />
                        <Button Content="Remove selected" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnRemoveClick" />
                    </StackPanel>
                </Border>

                <!-- Relay. -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Relay" Style="{DynamicResource BodyStrongTextBlockStyle}" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="The relay listens on 127.0.0.1 only. Point WSL at http://127.0.0.1 and this port." />
                        <Label Content="Port" Target="{Binding ElementName=ListenPortBox}" Padding="0,0,0,4" />
                        <TextBox x:Name="ListenPortBox" Width="96" HorizontalAlignment="Left" AutomationProperties.Name="Relay port" />
                        <CheckBox x:Name="DenyLocalBox" Margin="0,12,0,0"
                                  Content="Refuse local and reserved destinations (recommended)" />
                    </StackPanel>
                </Border>

                <!-- Startup. -->
                <Border Style="{StaticResource Card}">
                    <CheckBox x:Name="StartAtLoginBox" Content="Start WSL Proxy Relay when I sign in to Windows" />
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
