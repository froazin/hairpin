<Window x:Class="WSLProxy.UI.Views.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WSL Proxy Relay"
        Width="320"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}"
        BorderThickness="1"
        UseLayoutRounding="True">
    <Window.Resources>
        <!-- A flat, full-width row button, like the items in Windows 11's own tray flyouts. -->
        <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="4,1" />
        </Style>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Width" Value="28" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <StackPanel>
        <!-- Status card. -->
        <Border Margin="12,12,12,8" Padding="14,12" CornerRadius="8"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel>
                <DockPanel>
                    <Border x:Name="StateBadge" DockPanel.Dock="Right" CornerRadius="10" Padding="10,2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StateDot" Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="StateText" Style="{DynamicResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="WSL Proxy Relay" Style="{DynamicResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                </DockPanel>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Proxy" Margin="0,2,16,2" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Style="{DynamicResource CaptionTextBlockStyle}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="EndpointText" Margin="0,2" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                    <TextBlock Grid.Row="1" Text="Upstream" Margin="0,2,16,2" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Style="{DynamicResource CaptionTextBlockStyle}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="UpstreamText" Margin="0,2" TextTrimming="CharacterEllipsis" Style="{DynamicResource CaptionTextBlockStyle}" />
                    <TextBlock Grid.Row="2" Text="Traffic" Margin="0,2,16,2" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Style="{DynamicResource CaptionTextBlockStyle}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TrafficText" Margin="0,2" Style="{DynamicResource CaptionTextBlockStyle}" />
                </Grid>

                <Border x:Name="ErrorPanel" Margin="0,10,0,0" Padding="10,8" CornerRadius="4" Visibility="Collapsed"
                        Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}">
                    <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Style="{DynamicResource CaptionTextBlockStyle}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Actions. -->
        <Button x:Name="PauseButton" Style="{StaticResource RowButton}" Click="OnPauseClick" AutomationProperties.Name="Pause or resume the relay">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="PauseGlyph" Style="{StaticResource Glyph}" Text="&#xE769;" />
                <TextBlock x:Name="PauseText" Text="Pause" VerticalAlignment="Center" />
            </StackPanel>
        </Button>
        <Button x:Name="CopyButton" Style="{StaticResource RowButton}" Click="OnCopyClick" AutomationProperties.Name="Copy WSL setup to the clipboard">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C8;" />
                <TextBlock x:Name="CopyText" Text="Copy WSL setup" VerticalAlignment="Center" />
            </StackPanel>
        </Button>
        <Button Style="{StaticResource RowButton}" Click="OnSettingsClick" AutomationProperties.Name="Open settings">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" />
                <TextBlock Text="Settings and bypass list" VerticalAlignment="Center" />
            </StackPanel>
        </Button>
        <Button Style="{StaticResource RowButton}" Click="OnLogsClick" AutomationProperties.Name="Show the recent log lines">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8A5;" />
                <TextBlock Text="Logs" VerticalAlignment="Center" />
            </StackPanel>
        </Button>
        <Button Style="{StaticResource RowButton}" HorizontalContentAlignment="Stretch" Click="OnDebugClick"
                AutomationProperties.Name="Turn debug logging on or off until the app restarts">
            <DockPanel>
                <CheckBox x:Name="DebugBox" DockPanel.Dock="Right" IsHitTestVisible="False" Focusable="False" MinWidth="0"
                          VerticalAlignment="Center" Margin="8,0,0,0" />
                <TextBlock Style="{StaticResource Glyph}" Text="&#xEBE8;" />
                <TextBlock Text="Debug logging until restart" VerticalAlignment="Center" />
            </DockPanel>
        </Button>

        <Separator Margin="12,4" />

        <Button Style="{StaticResource RowButton}" Margin="4,1,4,8" Click="OnQuitClick" AutomationProperties.Name="Quit WSL Proxy Relay">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE7E8;" />
                <TextBlock Text="Quit" VerticalAlignment="Center" />
            </StackPanel>
        </Button>
    </StackPanel>
</Window>
