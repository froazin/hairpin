<Window x:Class="WSLProxy.UI.Views.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WSL Proxy Relay"
        Width="320"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}"
        BorderThickness="1"
        UseLayoutRounding="True">
    <Window.Resources>
        <!-- A flat, full-width row button, like the items in Windows 11's own tray flyouts. -->
        <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="4,1" />
        </Style>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Width" Value="28" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <StackPanel>
        <!-- Status card. -->
        <Border Margin="12,12,12,8" Padding="14,12" CornerRadius="8"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel>
                <DockPanel>
                    <Border x:Name="StateBadge" DockPanel.Dock="Right" CornerRadius="10" Padding="10,2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StateDot" Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="StateText" Style="{DynamicResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="WSL Proxy Relay" Style="{DynamicResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                </DockPanel>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Listening" Margin="0,2,16,2" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Style="{DynamicResource CaptionTextBlockStyle}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="EndpointText" Margin="0,2" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                    <TextBlock Grid.Row="1" x:Name="UpstreamLabel" Text="Upstream" Margin="0,2,16,2" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Style="{DynamicResource CaptionTextBlockStyle}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="UpstreamText" Margin="0,2" TextTrimming="CharacterEllipsis" Style="{DynamicResource CaptionTextBlockStyle}" />
                </Grid>

                <Border x:Name="ErrorPanel" Margin="0,10,0,0" Padding="10,8" CornerRadius="4" Visibility="Collapsed"
                        Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}">
                    <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Style="{DynamicResource CaptionTextBlockStyle}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Settings that stop mirrored mode, each with a one-line fix. -->
        <ItemsControl x:Name="ProblemsList" Margin="12,0,12,4" Visibility="Collapsed" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,6" Padding="12,10" CornerRadius="8"
                            Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xEB90;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,1,10,0" VerticalAlignment="Top" />
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Style="{DynamicResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{Binding Fix}" TextWrapping="Wrap" Margin="0,2,0,0" Style="{DynamicResource CaptionTextBlockStyle}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Traffic: rates, a chart of the last two minutes and totals. -->
        <Border Margin="12,0,12,8" Padding="14,12" CornerRadius="8"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="Last 2 minutes" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Style="{DynamicResource CaptionTextBlockStyle}" />
                    <TextBlock Text="Traffic" Style="{DynamicResource BodyStrongTextBlockStyle}" />
                </DockPanel>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="10" Height="3" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="Down" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Style="{DynamicResource CaptionTextBlockStyle}" />
                        </StackPanel>
                        <TextBlock x:Name="DownRateText" FontSize="16" Style="{DynamicResource BodyStrongTextBlockStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="10" Height="3" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="Up" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Style="{DynamicResource CaptionTextBlockStyle}" />
                        </StackPanel>
                        <TextBlock x:Name="UpRateText" FontSize="16" Style="{DynamicResource BodyStrongTextBlockStyle}" />
                    </StackPanel>
                </Grid>

                <Canvas x:Name="Chart" Height="44" Margin="0,8,0,0" ClipToBounds="True" SizeChanged="OnChartSizeChanged"
                        AutomationProperties.Name="Chart of traffic down and up over the last two minutes">
                    <Polygon x:Name="DownArea" Fill="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0.18" />
                    <Polyline x:Name="DownLine" Stroke="{DynamicResource AccentFillColorDefaultBrush}" StrokeThickness="1.5" StrokeLineJoin="Round" />
                    <Polyline x:Name="UpLine" Stroke="{DynamicResource TextFillColorSecondaryBrush}" StrokeThickness="1.25" StrokeLineJoin="Round" />
                </Canvas>
                <Border Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" />

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="OpenText" Style="{DynamicResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="Open" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Style="{DynamicResource CaptionTextBlockStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="RequestsText" Style="{DynamicResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="Req/m" ToolTip="Requests in the last minute" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Style="{DynamicResource CaptionTextBlockStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock x:Name="ErrorRateText" Style="{DynamicResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="Err%" ToolTip="Requests in the last 2 minutes that ended in an error" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Style="{DynamicResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="TotalsText" Margin="0,8,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Style="{DynamicResource CaptionTextBlockStyle}" />
            </StackPanel>
        </Border>

        <!-- Actions. -->
        <Button x:Name="CopyButton" Style="{StaticResource RowButton}" Click="OnCopyClick" AutomationProperties.Name="Copy WSL setup to the clipboard">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C8;" />
                <TextBlock x:Name="CopyText" Text="Copy WSL setup" VerticalAlignment="Center" />
            </StackPanel>
        </Button>
        <Button x:Name="PauseButton" Style="{StaticResource RowButton}" Click="OnPauseClick" AutomationProperties.Name="Pause or resume the relay">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="PauseGlyph" Style="{StaticResource Glyph}" Text="&#xE769;" />
                <TextBlock x:Name="PauseText" Text="Pause" VerticalAlignment="Center" />
            </StackPanel>
        </Button>
        <Button Style="{StaticResource RowButton}" Click="OnSettingsClick" AutomationProperties.Name="Open settings">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" />
                <TextBlock Text="Settings" VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <Separator Margin="12,4" />

        <Button Style="{StaticResource RowButton}" Margin="4,1,4,8" Click="OnQuitClick" AutomationProperties.Name="Quit WSL Proxy Relay">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE7E8;" />
                <TextBlock Text="Quit" VerticalAlignment="Center" />
            </StackPanel>
        </Button>
    </StackPanel>
</Window>
