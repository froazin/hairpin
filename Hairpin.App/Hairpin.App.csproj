<Project Sdk="Microsoft.NET.Sdk">

  <!-- The executable: wires the relay engine and the tray UI together in one Generic Host. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Hairpin.App</RootNamespace>
    <AssemblyName>Hairpin</AssemblyName>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>..\Assets\hairpin-logo.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- Publish a plain framework-dependent folder for each runtime: the app runs on the .NET Desktop Runtime installed on
         the machine, which Microsoft Update patches, rather than carrying its own copy that only a new build would
         patch. No single-file extraction to %TEMP%, and no trimming (unsupported by WPF). -->
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hairpin.Engine\Hairpin.Engine.csproj" />
    <ProjectReference Include="..\Hairpin.UI\Hairpin.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hairpin.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
