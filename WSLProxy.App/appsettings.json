{
  "Relay": {
    "ListenPort": 3128,
    "Upstream": {
      "Host": "",
      "Port": 80,
      "HealthCheckIntervalSeconds": 30
    },
    "NoProxy": [],
    "DenyLocalDestinations": true,
    "Limits": {
      "MaxRequestLineBytes": 8192,
      "MaxHeaderBytes": 32768,
      "MaxHeaderCount": 100,
      "HeaderTimeoutSeconds": 15,
      "ConnectTimeoutSeconds": 10,
      "IdleTimeoutSeconds": 120,
      "TunnelIdleTimeoutSeconds": 900,
      "MaxConnections": 512
    }
  },
  "App": {
    "StartAtLogin": true,
    "LogRetentionDays": 7
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  }
}
